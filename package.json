{
  "name": "lean-agents",
  "version": "0.1.0",
  "description": "A lean, director-first orchestration standard for Codex subagents: generate project-specific agents from one config file and lint existing setups.",
  "type": "module",
  "bin": {
    "lean-agents": "bin/lean-agents.js"
  },
  "files": [
    "bin",
    "src",
    "examples",
    "docs",
    "README.md",
    "README.es.md",
    "LICENSE",
    "CHANGELOG.md"
  ],
  "scripts": {
    "test": "node --test",
    "doctor:examples": "node bin/lean-agents.js doctor examples/sts-to-tts --strict"
  },
  "engines": {
    "node": ">=20"
  },
  "keywords": [
    "codex",
    "codex-cli",
    "agents",
    "subagents",
    "agents-md",
    "orchestration",
    "multi-agent",
    "linter"
  ],
  "author": "Daniel Carnevale",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/DaniCarnevale/lean-agents.git"
  },
  "dependencies": {
    "smol-toml": "^1.3.1"
  }
}
